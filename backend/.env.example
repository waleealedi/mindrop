

PORT=8787


FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json


OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# النشر (الإنتاج) — تُضبط بلوحة المستضيف، لا بملف بالمستودع.
# ---------------------------------------------------------------------------

# مفتاح حساب خدمة Firebase كسلسلة base64 بدل مسار ملف.
# القرص عند الاستضافات المجانية مؤقت، وملف المفتاح ما ينرفع للمستودع.
# ولّدها بـ:  base64 -i service-account.json | pbcopy
# نستخدم base64 مو JSON خام لأن الـ private key فيه أسطر جديدة تنفسد
# غالبًا عند لصقها بحقول متغيّرات البيئة.
# FIREBASE_SERVICE_ACCOUNT_B64=

# يبقي الصوت و<id>.json على القرص (تطوير محلي فقط).
# مطفي افتراضيًا: الإنتاج بلا حالة، والجوال هو مصدر الحقيقة للصوت.
# KEEP_AUDIO=1

# مجلد الرفع المؤقت. الافتراضي: مجلد النظام المؤقت (أو ./storage لما
# KEEP_AUDIO=1). نادرًا يحتاج ضبط يدوي.
# STORAGE_ROOT=
