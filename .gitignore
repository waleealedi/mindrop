# Widget Preview related
.widget_preview/

# ---------------------------------------------------------------------------
# Backend secrets and user data — NEVER commit these.
#
# backend/.gitignore already lists these, and nested .gitignore files DO work
# correctly from the repo root (patterns resolve relative to the file that
# declares them). They are repeated here on purpose as defence in depth: if
# backend/.gitignore is ever moved, renamed or deleted, that protection
# disappears silently and the next `git add -A` would commit real API keys and
# a Firebase private key. A root-level rule cannot be lost that way.
# ---------------------------------------------------------------------------
backend/node_modules/
backend/.env
backend/service-account.json

# The user's own recorded audio and transcripts. Private content, never
# version-controlled. The server is stateless by default now (KEEP_AUDIO off),
# so this only fills up when a developer opts in locally.
backend/storage/

# Any stray env or key files anywhere in the tree.
.env
.env.*
!.env.example
*service-account*.json
*-private-key.json
*.pem
*.p12
*.keystore
*.jks
